<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <link rel="icon" type="image/png" href="<%= botAvatar %>">
    <title>🐾 管理面版 | <%= botName %></title>
    
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- 引入 anime.js -->
    <script src="https://cdn.jsdelivr.net/npm/animejs@3.2.1/lib/anime.min.js"></script>
    
    <style>
        :root {
            --primary-color: #FFC8DD;
            --primary-hover: #FFAFCC;
            --dark-pink: #FF7B9C;
            --cat-orange: #FF9E5E;
            --dark-color: #2B2D42;
            --text-color: #4A4E69;
            --bg-gradient: linear-gradient(135deg, #FFE5EC 0%, #F0E6FF 100%);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Noto Sans TC', sans-serif;
        }

        body {
            background: var(--bg-gradient);
            color: var(--dark-color);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            padding-bottom: 40px;
        }

        /* 頂部歡迎區塊 - 毛玻璃卡片化 */
        .dashboard-header {
            background: rgba(255, 255, 255, 0.45);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.5);
            padding: 40px 20px;
            text-align: center;
            box-shadow: 0 8px 32px 0 rgba(255, 183, 197, 0.15);
            margin-bottom: 40px;
        }

        .user-info {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
            margin-bottom: 12px;
        }

        .user-avatar {
            width: 65px;
            height: 65px;
            border-radius: 50%;
            border: 3px solid white;
            box-shadow: 0 8px 20px rgba(255, 119, 154, 0.25);
            object-fit: cover;
        }

        .user-info h2 {
            font-size: 1.8rem;
            font-weight: 700;
            background: linear-gradient(45deg, #FF7B9C, #7455F7);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .dashboard-header p {
            color: var(--text-color);
            font-size: 1.05rem;
            font-weight: 500;
        }

        /* 伺服器網格布局 */
        .guild-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 30px;
            padding: 0 5%;
            max-width: 1280px;
            margin: 0 auto;
            width: 100%;
            flex: 1;
        }

        /* 伺服器卡片升級 - 導入高階毛玻璃 */
        .guild-card {
            background: rgba(255, 255, 255, 0.55);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 24px;
            padding: 35px 25px;
            text-align: center;
            transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
            box-shadow: 0 8px 32px 0 rgba(150, 150, 150, 0.05);
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        .guild-card:hover {
            transform: translateY(-8px) scale(1.02);
            background: rgba(255, 255, 255, 0.85);
            box-shadow: 0 15px 35px rgba(255, 166, 188, 0.35);
            border-color: rgba(255, 183, 197, 0.6);
        }

        /* 狀態標籤 (已加入/未加入) */
        .status-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            padding: 4px 12px;
            border-radius: 30px;
            font-size: 0.75rem;
            font-weight: 700;
        }
        .status-in {
            background: #E8F5E9;
            color: #2E7D32;
        }
        .status-out {
            background: #FFF3E0;
            color: #E65100;
        }

        /* 未加入伺服器的微灰階與透明度調校 */
        .guild-card.not-in-guild .guild-icon {
            filter: grayscale(30%);
            opacity: 0.85;
        }

        .guild-icon {
            width: 95px;
            height: 95px;
            border-radius: 24px;
            margin-bottom: 20px;
            object-fit: cover;
            background: white;
            box-shadow: 0 8px 20px rgba(0,0,0,0.06);
            border: 2px solid white;
        }

        .guild-name {
            font-size: 1.15rem;
            color: var(--dark-color);
            margin: 0 0 25px 0;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            width: 100%;
        }

        /* 現代圓潤 pill 顆粒按鈕 */
        .btn-action {
            width: 100%;
            padding: 12px 20px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.95rem;
            transition: all 0.3s;
            text-align: center;
            border: none;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            display: inline-flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
        }

        /* 管理設定按鈕 (漸層色) */
        .btn-manage {
            background: linear-gradient(45deg, #FF7B9C, #FF94B1);
            color: white;
        }
        .btn-manage:hover {
            box-shadow: 0 8px 20px rgba(255, 123, 156, 0.4);
            transform: translateY(-2px);
        }

        /* 邀請進群按鈕 (暖橘色漸層) */
        .btn-invite {
            background: linear-gradient(45deg, var(--cat-orange), #FFAE73);
            color: white;
        }
        .btn-invite:hover {
            box-shadow: 0 8px 20px rgba(255, 158, 94, 0.4);
            transform: translateY(-2px);
        }

        /* 底部導航鏈結 */
        .back-home {
            text-align: center;
            margin-top: 50px;
            padding: 25px;
            background: rgba(255, 255, 255, 0.3);
            backdrop-filter: blur(5px);
            -webkit-backdrop-filter: blur(5px);
            border-top: 1px solid rgba(255, 255, 255, 0.3);
        }

        .back-home a {
            color: var(--text-color);
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 500;
            margin: 0 20px;
            transition: all 0.3s;
        }

        .back-home a:hover {
            color: var(--dark-pink);
        }

        /* 找不到伺服器的虛線框框 */
        .no-guilds {
            grid-column: 1 / -1;
            text-align: center;
            padding: 80px 20px;
            background: rgba(255, 255, 255, 0.4);
            border-radius: 30px;
            border: 2px dashed rgba(255, 183, 197, 0.6);
            backdrop-filter: blur(10px);
        }

        .no-guilds i {
            font-size: 3rem;
            color: var(--dark-pink);
            margin-bottom: 15px;
        }

        .no-guilds p { font-size: 1.1rem; margin: 8px 0; font-weight: 500; }
    </style>
</head>
<body>

    <div class="dashboard-header">
        <div class="user-info">
            <% 
                const avatarURL = user.avatar 
                    ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=128` 
                    : `https://cdn.discordapp.com/embed/avatars/${user.discriminator % 5}.png`;
            %>
            <img src="<%= avatarURL %>" alt="avatar" class="user-avatar" id="userAvatar">
            <h2 id="userGreeting">你好喵，<%= user.username %>！</h2>
        </div>
        <p>請選擇一個你管理的伺服器來進行設定面板喵 🐾</p>
    </div>

    <div class="guild-list">
        <% if (guilds && guilds.length > 0) { %>
            <% guilds.forEach((guild, index) => { %>
                <div class="guild-card <%= guild.botInGuild ? '' : 'not-in-guild' %>" style="--index: <%= index %>">
                    
                    <% if (guild.botInGuild) { %>
                        <span class="status-badge status-in"><i class="fa-solid fa-circle-check"></i> 已加入</span>
                    <% } else { %>
                        <span class="status-badge status-out"><i class="fa-solid fa-circle-plus"></i> 未加入</span>
                    <% } %>

                    <% if (guild.icon) { %>
                        <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" class="guild-icon" alt="<%= guild.name %>">
                    <% } else { %>
                        <div class="guild-icon" style="display: flex; align-items: center; justify-content: center; color: var(--dark-pink); font-size: 2.5rem;">🐾</div>
                    <% } %>
                    
                    <h4 class="guild-name"><%= guild.name %></h4>
                    
                    <% if (guild.botInGuild) { %>
                        <a href="/manage/<%= guild.id %>" class="btn-action btn-manage">
                            <i class="fa-solid fa-sliders"></i> 管理設定
                        </a>
                    <% } else { %>
                        <a href="https://discord.com/api/oauth2/authorize?client_id=<%= clientId %>&permissions=8&scope=bot%20applications.commands&guild_id=<%= guild.id %>&disable_guild_select=true" class="btn-action btn-invite">
                            <i class="fa-solid fa-plus"></i> 邀請銀喵
                        </a>
                    <% } %>
                </div>
            <% }); %>
        <% } else { %>
            <div class="no-guilds">
                <i class="fa-solid fa-cat-space"></i>
                <p>喵... 找不到你有管理員權限的伺服器。</p>
                <p style="color: var(--text-color); opacity: 0.7; font-size: 0.95rem;">請確認你在該伺服器中確實擁有「管理員」權限喔！</p>
            </div>
        <% } %>
    </div>

    <div class="back-home">
        <a href="/"><i class="fa-solid fa-house"></i> 返回首頁</a>
        <span style="color: rgba(0,0,0,0.1);">|</span>
        <a href="/logout" style="color: #ff4d4d;"><i class="fa-solid fa-right-from-bracket"></i> 登出帳號</a>
    </div>

    <script>
        // anime.js 動畫設定
        document.addEventListener('DOMContentLoaded', function() {
            // 頭部動畫
            anime({
                targets: '.dashboard-header',
                opacity: [0, 1],
                translateY: [-30, 0],
                duration: 600,
                easing: 'easeOutQuad'
            });

            // 伺服器卡片級聯動畫
            anime({
                targets: '.guild-card',
                opacity: [0, 1],
                translateY: [30, 0],
                scale: [0.9, 1],
                duration: 500,
                delay: anime.stagger(80),
                easing: 'easeOutQuad'
            });

            // 卡片懸停時的額外動畫
            document.querySelectorAll('.guild-card').forEach(card => {
                card.addEventListener('mouseenter', function() {
                    anime({
                        targets: this,
                        rotate: [0, 2, -2, 0],
                        duration: 300,
                        easing: 'easeInOutQuad'
                    });
                });
            });
        });
    </script>
</body>
</html>