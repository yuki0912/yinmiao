<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="icon" type="image/png" href="<%= typeof botAvatar !== 'undefined' ? botAvatar : '' %>">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Embed 廣播' %> | <%= typeof botName !== 'undefined' ? botName : '銀喵' %></title>
  <style>:root{--bg:linear-gradient(135deg,#fff0f3,#ffe3e8 50%,#fbcfe8);--card:rgba(255,255,255,.86);--border:rgba(244,114,182,.25);--pink:#f43f5e;--pink2:#fb7185;--dark:#be123c;--text:#334155;--muted:#64748b;--danger:#ef4444}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{min-height:100vh;padding:32px 16px;background:var(--bg);background-attachment:fixed;color:var(--text);font-family:"Noto Sans TC",sans-serif}
button,input,textarea{font:inherit}
button{cursor:pointer}
.container{width:100%;max-width:880px;margin:auto}
.btn-back{display:inline-flex;align-items:center;gap:7px;margin:8px 0 20px;color:var(--dark);font-weight:600;text-decoration:none}
.btn-back:hover{opacity:.8}
header{text-align:center;margin-bottom:28px}
.header-avatar{width:68px;height:68px;border-radius:50%;margin-bottom:10px;border:3px solid #fff;box-shadow:0 8px 20px rgba(244,63,94,.25);object-fit:cover}
h1{margin-bottom:8px;font-size:clamp(1.7rem,4vw,2.1rem);font-weight:800;background:linear-gradient(135deg,#e11d48,#f43f5e 50%,#db2777);background-clip:text;-webkit-background-clip:text;-webkit-text-fill-color:transparent}
header p{margin:4px 0;color:var(--muted);font-size:.95rem;font-weight:500}
.card{background:var(--card);backdrop-filter:blur(12px);border:1px solid var(--border);border-radius:20px;box-shadow:0 10px 30px rgba(244,114,182,.12)}
.channel-select-group{position:relative;z-index:10;padding:22px;margin-bottom:20px}
label{display:flex;align-items:center;gap:6px;margin-bottom:9px;font-size:.93rem;font-weight:700;color:#1e293b}
.searchable-select{position:relative}
.select-arrow{position:absolute;right:16px;top:50%;transform:translateY(-50%);pointer-events:none;color:#f472b6;transition:transform .2s,color .2s}
.searchable-select.active .select-arrow{transform:translateY(-50%) rotate(180deg);color:#e11d48}
.dropdown-menu{position:absolute;top:calc(100% + 8px);left:0;right:0;z-index:9999;display:none;max-height:240px;overflow:auto;background:#fff;border:1px solid var(--border);border-radius:14px;box-shadow:0 12px 35px rgba(244,63,94,.2)}
.dropdown-menu.show{display:block}
.dropdown-item{padding:11px 16px;display:flex;align-items:center;gap:8px;cursor:pointer;transition:background .15s,color .15s}
.dropdown-item:hover,.dropdown-item:focus{background:#fff1f2;color:#e11d48;font-weight:600;outline:0}
.dropdown-item[hidden]{display:none}
.no-result{padding:15px;text-align:center;color:var(--muted);font-size:.9rem}
input[type=text],textarea{width:100%;padding:12px 15px;border:1.5px solid #fbcfe8;border-radius:12px;background:#fff;color:var(--text);font-size:.95rem;transition:border-color .2s,box-shadow .2s}
.searchable-select input{padding-right:42px}
input[type=text]:focus,textarea:focus{outline:none;border-color:var(--pink);box-shadow:0 0 0 4px rgba(244,63,94,.15)}
.embed-card{position:relative;z-index:1;padding:22px;margin-bottom:18px;background:var(--card);backdrop-filter:blur(12px);border:1px solid var(--border);border-left:6px solid var(--pink2);border-radius:20px;box-shadow:0 10px 30px rgba(244,114,182,.1)}
.embed-card-header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px;padding-bottom:11px;border-bottom:1px solid #ffe4e8}
.embed-card-title{color:#e11d48;font-size:1.05rem;font-weight:800}
.btn-delete{padding:6px 12px;border:1px solid #fecaca;border-radius:10px;background:#fef2f2;color:var(--danger);font-weight:600}
.btn-delete:hover{background:var(--danger);color:#fff}
.form-grid{display:grid;grid-template-columns:minmax(0,1fr) 110px;gap:14px}
.form-grid--equal{grid-template-columns:repeat(2,minmax(0,1fr))}
.form-group{margin-bottom:14px}
textarea{min-height:100px;resize:vertical;line-height:1.5}
.color-picker-wrapper{display:flex;flex-direction:column}
input[type=color]{width:100%;height:44px;padding:4px;border:1.5px solid #fbcfe8;border-radius:12px;background:#fff;cursor:pointer}
.action-bar{display:flex;gap:14px;margin-top:24px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 24px;border:0;border-radius:14px;font-size:1rem;font-weight:700;transition:transform .2s,box-shadow .2s,background .2s}
.btn:active{transform:scale(.98)}
.btn-add{background:#fff;color:#e11d48;border:2px dashed #f472b6}
.btn-add:hover{background:#fff1f2;border-style:solid}
.btn-submit{flex:1;background:linear-gradient(135deg,#f43f5e,#e11d48);color:#fff;box-shadow:0 6px 20px rgba(244,63,94,.3)}
.btn-submit:hover:not(:disabled){transform:translateY(-1px);box-shadow:0 8px 25px rgba(244,63,94,.4)}
.btn-submit:disabled{opacity:.6;cursor:not-allowed;transform:none}
.counter-badge{padding:2px 9px;border-radius:20px;background:#ffe4e8;color:#be123c;font-size:.82rem}
@media(max-width:640px){body{padding:24px 12px}.form-grid,.form-grid--equal{grid-template-columns:1fr}.action-bar{flex-direction:column}.btn{width:100%}}
</style>
</head>
<body>
<main class="container">
  <a href="/manage/<%= typeof guildId !== 'undefined' ? guildId : '' %>" class="btn-back">
    <i class="fa-solid fa-arrow-left"></i> 返回群組管理首頁
  </a>

  <header>
    <% if (typeof botAvatar !== 'undefined' && botAvatar) { %>
      <img src="<%= botAvatar %>" alt="Bot Avatar" class="header-avatar">
    <% } %>
    <h1>🌸 Embed 卡片廣播</h1>
    <p>自訂粉嫩資訊卡片，發送到指定的 Discord 頻道 🌸</p>
    <p>正在設定伺服器：<strong style="color:var(--dark)"><%= typeof guildName !== 'undefined' ? guildName : '' %></strong></p>
  </header>

  <form id="embedForm" novalidate>
    <section class="channel-select-group card">
      <label for="channelSearchInput">📢 選擇或搜尋目標文字頻道</label>
      <div class="searchable-select" id="searchableSelect">
        <input type="text" id="channelSearchInput" placeholder="🔍 點擊選取或輸入頻道名稱/ID..." autocomplete="off" aria-haspopup="listbox" aria-expanded="false">
        <i class="fa-solid fa-chevron-down select-arrow" aria-hidden="true"></i>
        <input type="hidden" id="channelId" name="channelId" required>
        <div class="dropdown-menu" id="dropdownMenu" role="listbox">
          <% if (typeof channels !== 'undefined' && channels.length > 0) { %>
            <% channels.forEach(channel => { %>
              <div class="dropdown-item" role="option" tabindex="0" data-id="<%= channel.id %>" data-name="<%= channel.name %>"># <%= channel.name %></div>
            <% }) %>
          <% } else { %>
            <div class="no-result">無可用頻道</div>
          <% } %>
        </div>
      </div>
    </section>

    <div id="embedsContainer" aria-live="polite"></div>

    <div class="action-bar">
      <button type="button" class="btn btn-add" id="btnAddCard">🌸 追加卡片 <span class="counter-badge" id="cardCounter">(共 0 張)</span></button>
      <button type="submit" class="btn btn-submit" id="btnSubmit">🚀 發送到頻道</button>
    </div>
  </form>
</main>

<script>
(() => {
  'use strict';

  const $ = (selector, root = document) => root.querySelector(selector);
  const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];

  const container = $('#embedsContainer');
  const form = $('#embedForm');
  const addButton = $('#btnAddCard');
  const submitButton = $('#btnSubmit');
  const counter = $('#cardCounter');
  const select = $('#searchableSelect');
  const searchInput = $('#channelSearchInput');
  const channelId = $('#channelId');
  const dropdown = $('#dropdownMenu');
  const items = $$('.dropdown-item', dropdown);
  const colors = ['#FFB7C5','#F43F5E','#FB7185','#F472B6','#E879F9','#38BDF8','#34D399','#FBBF24'];

  const setDropdown = (open) => {
    dropdown.classList.toggle('show', open);
    select.classList.toggle('active', open);
    searchInput.setAttribute('aria-expanded', String(open));
  };

  const selectChannel = (item) => {
    searchInput.value = `# ${item.dataset.name || ''}`;
    channelId.value = item.dataset.id || '';
    setDropdown(false);
  };

  searchInput.addEventListener('focus', () => setDropdown(true));

  document.addEventListener('click', (event) => {
    if (!select.contains(event.target)) setDropdown(false);
  });

  searchInput.addEventListener('input', () => {
    const query = searchInput.value.toLowerCase().trim();
    channelId.value = /^\d+$/.test(query) ? query : '';

    items.forEach(item => {
      const name = (item.dataset.name || '').toLowerCase();
      const id = (item.dataset.id || '').toLowerCase();
      item.hidden = Boolean(query) && !name.includes(query) && !id.includes(query);
    });

    setDropdown(true);
  });

  items.forEach(item => {
    item.addEventListener('click', () => selectChannel(item));
    item.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        selectChannel(item);
      }
    });
  });

  function updateCards() {
    const cards = $$('.embed-card', container);
    counter.textContent = `(共 ${cards.length} 張)`;

    cards.forEach((card, index) => {
      $('.embed-card-title', card).textContent = `🌸 Embed 卡片 #${index + 1}`;
      const removeButton = $('.btn-delete', card);
      removeButton.hidden = cards.length <= 1;
    });
  }

  function createCard() {
    const index = container.children.length;
    const color = colors[index % colors.length];
    const card = document.createElement('section');

    card.className = 'embed-card';
    card.style.borderLeftColor = color;
    card.innerHTML = `
      <div class="embed-card-header">
        <span class="embed-card-title">🌸 Embed 卡片 #${index + 1}</span>
        <button type="button" class="btn-delete" aria-label="刪除此卡片">🗑️ 刪除</button>
      </div>

      <div class="form-grid">
        <div class="form-group">
          <label>卡片標題</label>
          <input type="text" class="embed-title" placeholder="請輸入標題..." required>
        </div>
        <div class="form-group color-picker-wrapper">
          <label>邊框顏色</label>
          <input type="color" class="embed-color" value="${color}">
        </div>
      </div>

      <div class="form-group">
        <label>內文描述</label>
        <textarea class="embed-description" placeholder="輸入卡片內容描述..."></textarea>
      </div>

      <div class="form-grid form-grid--equal">
        <div class="form-group">
          <label>圖片網址 (Image URL)</label>
          <input type="text" class="embed-image" placeholder="https://i.imgur.com/...">
        </div>
        <div class="form-group">
          <label>頁尾文字 (Footer)</label>
          <input type="text" class="embed-footer" placeholder="頁尾小字說明...">
        </div>
      </div>
    `;

    $('.btn-delete', card).addEventListener('click', () => {
      card.remove();
      updateCards();
    });

    $('.embed-color', card).addEventListener('input', (event) => {
      card.style.borderLeftColor = event.target.value;
    });

    container.appendChild(card);
    updateCards();
  }

  addButton.addEventListener('click', createCard);

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    const selectedChannel = channelId.value.trim();
    if (!selectedChannel) {
      alert('請先選擇或輸入有效的目標文字頻道 ID 🌸！');
      searchInput.focus();
      return;
    }

    const embeds = $$('.embed-card', container).map(card => ({
      title: $('.embed-title', card).value.trim(),
      color: $('.embed-color', card).value,
      description: $('.embed-description', card).value.trim(),
      image: $('.embed-image', card).value.trim(),
      footer: $('.embed-footer', card).value.trim()
    }));

    if (!embeds.length) {
      alert('請至少新增一張 Embed 卡片 🌸！');
      return;
    }

    submitButton.disabled = true;
    submitButton.textContent = '⏳ 正在發送中...';

    try {
      const response = await fetch('/api/send-embed', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          guildId: '<%= typeof guildId !== "undefined" ? guildId : "" %>',
          channelId: selectedChannel,
          embeds
        })
      });

      let result;
      try {
        result = await response.json();
      } catch {
        throw new Error(`HTTP ${response.status}`);
      }

      if (result.status === 'success') {
        alert(result.message);
      } else {
        alert(`發送失敗：${result.message || '未知錯誤'}`);
      }
    } catch (error) {
      console.error('發送錯誤:', error);
      alert('發送時發生系統錯誤🌸！');
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = '🚀 發送到頻道';
    }
  });

  createCard();
})();
</script>
</body>
</html>