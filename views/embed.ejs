<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- 引入 Font Awesome 圖示庫 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="<%= typeof botAvatar !== 'undefined' ? botAvatar : '' %>">
    <title>
        <%= typeof pageTitle !== 'undefined' ? pageTitle : 'Embed 廣播' %> | <%= typeof botName !== 'undefined' ? botName : '銀喵' %>
    </title>
    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #fff0f3 0%, #ffe3e8 50%, #fbcfe8 100%);
            --card-bg: rgba(255, 255, 255, 0.85);
            --card-border: rgba(244, 114, 182, 0.25);
            --accent-color: #f43f5e;
            --accent-pink: #fb7185;
            --accent-soft: #fbcfe8;
            --accent-glow: rgba(244, 63, 94, 0.2);
            --dark-pink: #be123c;
            --input-bg: rgba(255, 255, 255, 0.95);
            --text-main: #334155;
            --text-muted: #64748b;
            --danger-color: #ef4444;
            --danger-hover: #dc2626;
            --success-color: #10b981;
            --success-hover: #059669;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Noto Sans TC', sans-serif;
        }

        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(255, 241, 242, 0.6);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb {
            background: #f472b6;
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #e11d48;
        }

        body {
            background: var(--bg-gradient);
            background-attachment: fixed;
            color: var(--text-main);
            padding: 40px 20px;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
        }

        .container {
            width: 100%;
            max-width: 880px;
        }

        .btn-back {
            text-decoration: none;
            color: var(--dark-pink);
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: opacity 0.2s;
        }

        .btn-back:hover {
            opacity: 0.8;
        }

        header {
            margin-bottom: 32px;
            text-align: center;
            position: relative;
        }

        .header-avatar {
            width: 68px;
            height: 68px;
            border-radius: 50%;
            margin-bottom: 12px;
            border: 3px solid #ffffff;
            box-shadow: 0 8px 20px rgba(244, 63, 94, 0.25);
            object-fit: cover;
        }

        header h1 {
            font-size: 2.1rem;
            font-weight: 800;
            background: linear-gradient(135deg, #e11d48 0%, #f43f5e 50%, #db2777 100%);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 8px;
            letter-spacing: 0.5px;
        }

        header p {
            color: var(--text-muted);
            font-size: 0.95rem;
            font-weight: 500;
            margin-bottom: 4px;
        }

        .channel-select-group {
            position: relative;
            z-index: 100;
            background: var(--card-bg);
            backdrop-filter: blur(12px);
            border: 1px solid var(--card-border);
            padding: 24px;
            border-radius: 20px;
            margin-bottom: 24px;
            box-shadow: 0 10px 30px rgba(244, 114, 182, 0.12);
        }

        label {
            display: flex;
            align-items: center;
            gap: 6px;
            font-weight: 700;
            margin-bottom: 10px;
            font-size: 0.95rem;
            color: #1e293b;
        }

        .searchable-select {
            position: relative;
            display: flex;
            align-items: center;
        }

        .select-arrow {
            position: absolute;
            right: 16px;
            color: #f472b6;
            pointer-events: none;
            transition: transform 0.25s ease, color 0.25s ease;
            font-size: 0.9rem;
        }

        .searchable-select.active .select-arrow {
            transform: rotate(180deg);
            color: #e11d48;
        }

        .dropdown-menu {
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            right: 0;
            max-height: 240px;
            overflow-y: auto;
            background-color: #ffffff;
            border: 1px solid var(--card-border);
            border-radius: 14px;
            z-index: 9999;
            display: none;
            box-shadow: 0 12px 35px rgba(244, 63, 94, 0.2);
            animation: fadeIn 0.2s ease;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-6px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .dropdown-menu.show {
            display: block;
        }

        .dropdown-item {
            padding: 12px 16px;
            cursor: pointer;
            color: var(--text-main);
            transition: all 0.15s ease;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .dropdown-item:hover {
            background-color: #fff1f2;
            color: #e11d48;
            padding-left: 20px;
            font-weight: 600;
        }

        .no-result {
            padding: 16px;
            color: var(--text-muted);
            text-align: center;
            font-size: 0.9rem;
        }

        input[type="text"],
        textarea {
            width: 100%;
            padding: 12px 40px 12px 16px;
            border-radius: 12px;
            border: 1.5px solid #fbcfe8;
            background-color: var(--input-bg);
            color: var(--text-main);
            font-size: 0.95rem;
            transition: all 0.25s ease;
        }

        input[type="text"]:focus,
        textarea:focus {
            outline: none;
            border-color: #f43f5e;
            box-shadow: 0 0 0 4px rgba(244, 63, 94, 0.15);
            background-color: #ffffff;
        }

        .embed-card {
            background: var(--card-bg);
            backdrop-filter: blur(12px);
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 20px;
            border: 1px solid var(--card-border);
            border-left: 6px solid #fb7185;
            position: relative;
            z-index: 1;
            box-shadow: 0 10px 30px rgba(244, 114, 182, 0.1);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .embed-card:hover {
            box-shadow: 0 14px 35px rgba(244, 114, 182, 0.18);
        }

        .embed-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
            padding-bottom: 12px;
            border-bottom: 1px solid #ffe4e8;
        }

        .embed-card-title {
            font-weight: 800;
            font-size: 1.1rem;
            color: #e11d48;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-delete {
            background: #fef2f2;
            color: var(--danger-color);
            border: 1px solid #fecaca;
            padding: 6px 14px;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.85rem;
            transition: all 0.2s ease;
        }

        .btn-delete:hover {
            background: var(--danger-color);
            color: white;
            transform: translateY(-1px);
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 110px;
            gap: 16px;
            margin-bottom: 14px;
        }

        .form-group {
            margin-bottom: 14px;
        }

        textarea {
            resize: vertical;
            min-height: 100px;
            line-height: 1.5;
        }

        .color-picker-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .color-picker-wrapper input[type="color"] {
            width: 100%;
            height: 44px;
            padding: 4px;
            border-radius: 12px;
            border: 1.5px solid #fbcfe8;
            background-color: var(--input-bg);
            cursor: pointer;
            transition: border-color 0.2s;
        }

        .color-picker-wrapper input[type="color"]:hover {
            border-color: #f43f5e;
        }

        .action-bar {
            display: flex;
            gap: 16px;
            justify-content: space-between;
            margin-top: 28px;
        }

        .btn {
            padding: 14px 28px;
            border-radius: 14px;
            border: none;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn:active {
            transform: scale(0.97);
        }

        .btn-add {
            background-color: #ffffff;
            color: #e11d48;
            border: 2px dashed #f472b6;
            box-shadow: 0 4px 15px rgba(244, 114, 182, 0.1);
        }

        .btn-add:hover {
            background-color: #fff1f2;
            border-style: solid;
            border-color: #e11d48;
            box-shadow: 0 6px 20px rgba(244, 114, 182, 0.2);
        }

        .btn-submit {
            background: linear-gradient(135deg, #f43f5e 0%, #e11d48 100%);
            color: white;
            flex-grow: 1;
            box-shadow: 0 6px 20px rgba(244, 63, 94, 0.3);
        }

        .btn-submit:hover {
            background: linear-gradient(135deg, #fb7185 0%, #f43f5e 100%);
            box-shadow: 0 8px 25px rgba(244, 63, 94, 0.4);
            transform: translateY(-2px);
        }

        .btn-submit:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        .counter-badge {
            font-size: 0.85rem;
            padding: 2px 10px;
            border-radius: 20px;
            background: #ffe4e8;
            color: #be123c;
            margin-left: 4px;
        }

        @media (max-width: 640px) {
            .form-grid {
                grid-template-columns: 1fr;
            }

            .action-bar {
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

    <div class="container">
        <div style="margin-top: 12px; margin-bottom: 16px;">
            <a href="/manage/<%= typeof guildId !== 'undefined' ? guildId : '' %>" class="btn-back">
                <i class="fa-solid fa-arrow-left"></i> 返回群組管理首頁
            </a>
        </div>

        <header>
            <% if (typeof botAvatar !== 'undefined' && botAvatar) { %>
                <img src="<%= botAvatar %>" alt="Bot Avatar" class="header-avatar">
            <% } %>
            <h1>🌸 Embed 卡片廣播</h1>
            <p>自訂粉嫩資訊卡片，發送到指定的 Discord 頻道 🌸</p>
            <p style="color: var(--text-muted); font-weight: 500;">正在設定伺服器：<span
                    style="color: var(--dark-pink); font-weight: 700;">
                    <%= typeof guildName !== 'undefined' ? guildName : '' %>
                </span></p>
        </header>

        <form id="embedForm">
            <!-- 可搜尋頻道區域 -->
            <div class="channel-select-group">
                <label for="channelSearchInput">📢 選擇或搜尋目標文字頻道</label>
                <div class="searchable-select" id="searchableSelect">
                    <input type="text" id="channelSearchInput" placeholder="🔍 點擊選取或輸入頻道名稱/ID..." autocomplete="off">
                    <i class="fa-solid fa-chevron-down select-arrow"></i>
                    <input type="hidden" id="channelId" name="channelId" required>

                    <div class="dropdown-menu" id="dropdownMenu">
                        <% if (typeof channels !== 'undefined' && channels.length > 0) { %>
                            <% channels.forEach(channel => { %>
                                <div class="dropdown-item" data-id="<%= channel.id %>" data-name="<%= channel.name %>">
                                    # <%= channel.name %>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="no-result">無可用頻道</div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- 動態 Embed 卡片容器 -->
            <div id="embedsContainer"></div>

            <!-- 操作按鈕列 -->
            <div class="action-bar">
                <button type="button" class="btn btn-add" id="btnAddCard">
                    🌸 追加卡片 <span class="counter-badge" id="cardCounter">(共 0 張)</span>
                </button>
                <button type="submit" class="btn btn-submit" id="btnSubmit">🚀 發送到頻道</button>
            </div>
        </form>
    </div>

    <script>
        const embedsContainer = document.getElementById('embedsContainer');
        const btnAddCard = document.getElementById('btnAddCard');
        const cardCounter = document.getElementById('cardCounter');
        const embedForm = document.getElementById('embedForm');
        const btnSubmit = document.getElementById('btnSubmit');

        const searchableSelect = document.getElementById('searchableSelect');
        const channelSearchInput = document.getElementById('channelSearchInput');
        const channelIdInput = document.getElementById('channelId');
        const dropdownMenu = document.getElementById('dropdownMenu');
        const dropdownItems = dropdownMenu.querySelectorAll('.dropdown-item');

        const defaultColors = ['#FFB7C5', '#F43F5E', '#FB7185', '#F472B6', '#E879F9', '#38BDF8', '#34D399', '#FBBF24'];

        function openDropdown() {
            dropdownMenu.classList.add('show');
            searchableSelect.classList.add('active');
        }

        function closeDropdown() {
            dropdownMenu.classList.remove('show');
            searchableSelect.classList.remove('active');
        }

        channelSearchInput.addEventListener('focus', openDropdown);

        document.addEventListener('click', (e) => {
            if (!searchableSelect.contains(e.target)) {
                closeDropdown();
            }
        });

        channelSearchInput.addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase().trim();

            if (/^\d+$/.test(query)) {
                channelIdInput.value = query;
            } else {
                channelIdInput.value = '';
            }

            dropdownItems.forEach(item => {
                const name = item.dataset.name ? item.dataset.name.toLowerCase() : '';
                const id = item.dataset.id ? item.dataset.id.toLowerCase() : '';

                if (name.includes(query) || id.includes(query)) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });

            openDropdown();
        });

        dropdownItems.forEach(item => {
            item.addEventListener('click', () => {
                const name = item.dataset.name;
                const id = item.dataset.id;

                channelSearchInput.value = `# ${name}`;
                channelIdInput.value = id;
                closeDropdown();
            });
        });

        function updateCardState() {
            const cards = embedsContainer.querySelectorAll('.embed-card');
            cardCounter.innerText = `(共 ${cards.length} 張)`;

            cards.forEach((card, index) => {
                card.querySelector('.embed-card-title').innerText = `🌸 Embed 卡片 #${index + 1}`;
                const deleteBtn = card.querySelector('.btn-delete');
                if (deleteBtn) {
                    deleteBtn.style.display = cards.length > 1 ? 'inline-block' : 'none';
                }
            });
        }

        function changeCardColor(picker) {
            const card = picker.closest('.embed-card');
            card.style.borderLeftColor = picker.value;
        }

        function createEmbedCard() {
            const count = embedsContainer.children.length;
            const defaultColor = defaultColors[count % defaultColors.length];

            const card = document.createElement('div');
            card.className = 'embed-card';
            card.style.borderLeftColor = defaultColor;

            card.innerHTML = `
            <div class="embed-card-header">
                <span class="embed-card-title">🌸 Embed 卡片 #${count + 1}</span>
                <button type="button" class="btn-delete" onclick="removeCard(this)">🗑️ 刪除</button>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label>卡片標題</label>
                    <input type="text" class="embed-title" placeholder="請輸入標題..." required>
                </div>
                <div class="form-group color-picker-wrapper">
                    <label>邊框顏色</label>
                    <input type="color" class="embed-color" value="${defaultColor}" onchange="changeCardColor(this)">
                </div>
            </div>

            <div class="form-group">
                <label>內文描述</label>
                <textarea class="embed-description" placeholder="輸入卡片內容描述..."></textarea>
            </div>

            <div class="form-grid" style="grid-template-columns: 1fr 1fr;">
                <div class="form-group">
                    <label>圖片網址 (Image URL)</label>
                    <input type="text" class="embed-image" placeholder="https://i.imgur.com/...">
                </div>
                <div class="form-group">
                    <label>頁尾文字 (Footer)</label>
                    <input type="text" class="embed-footer" placeholder="頁尾小字說明...">
                </div>
            </div>
        `;

            embedsContainer.appendChild(card);
            updateCardState();
        }

        function removeCard(btn) {
            btn.closest('.embed-card').remove();
            updateCardState();
        }

        btnAddCard.addEventListener('click', createEmbedCard);

        embedForm.addEventListener('submit', async (e) => {
            e.preventDefault();

            const channelId = channelIdInput.value.trim();
            if (!channelId) {
                alert('請先選擇或輸入有效的目標文字頻道 ID 🌸！');
                return;
            }

            const cards = embedsContainer.querySelectorAll('.embed-card');
            const embeds = [];

            cards.forEach(card => {
                embeds.push({
                    title: card.querySelector('.embed-title').value.trim(),
                    color: card.querySelector('.embed-color').value,
                    description: card.querySelector('.embed-description').value.trim(),
                    image: card.querySelector('.embed-image').value.trim(),
                    footer: card.querySelector('.embed-footer').value.trim()
                });
            });

            btnSubmit.disabled = true;
            btnSubmit.innerText = '⏳ 正在發送中...';

            try {
                const response = await fetch('/api/send-embed', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        guildId: '<%= typeof guildId !== "undefined" ? guildId : "" %>',
                        channelId,
                        embeds
                    })
                });

                const result = await response.json();

                if (result.status === 'success') {
                    alert(result.message);
                } else {
                    alert(`發送失敗：${result.message}`);
                }
            } catch (err) {
                console.error('發送錯誤:', err);
                alert('發送時發生系統錯誤🌸！');
            } finally {
                btnSubmit.disabled = false;
                btnSubmit.innerText = '🚀 發送到頻道';
            }
        });

        createEmbedCard();
    </script>

</body>

</html>