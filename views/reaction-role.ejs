<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="<%= botAvatar %>">
    <title>反應身分組管理面板 | <%= guildName %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/emoji-mart@latest/dist/browser.js"></script>
    
    <style>
        /* 採用與 rules.ejs 完全一致的明亮粉紫夢幻雙色漸層底色與全域文字色設定 */
        body { 
            background: linear-gradient(135deg, #FFE5EC 0%, #F0E6FF 100%); 
            color: #2B2D42; 
            font-family: 'Helvetica Neue', Arial, sans-serif;
            min-height: 100vh;
        }
        /* 亮色系專用精緻粉嫩捲動條 */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #FFE5EC; }
        ::-webkit-scrollbar-thumb { background: #FFAFCC; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #FF7B9C; }
        .no-scrollbar::-webkit-scrollbar { display: none; }

        /* 全域毛玻璃精緻卡片特效 */
        .glass-card {
            background: rgba(255, 255, 255, 0.45);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 8px 32px 0 rgba(255, 182, 193, 0.2);
        }
        .glass-input {
            background: rgba(255, 255, 255, 0.6);
            border: 1px solid rgba(255, 182, 193, 0.5);
            transition: all 0.3s ease;
        }
        .glass-input:focus {
            background: rgba(255, 255, 255, 0.9);
            border-color: #FF7B9C;
            box-shadow: 0 0 0 3px rgba(255, 200, 221, 0.5);
        }
    </style>
</head>
<body class="flex flex-col">

    <%- include('partials/navbar') %>

    <input type="hidden" id="guildId" value="<%= guildId %>">

    <div class="max-w-6xl w-full mx-auto px-4 pb-12 flex-1">
        
        <div class="glass-card rounded-2xl p-6 mb-8 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex items-center gap-4">
                <div class="p-3 bg-pink-100/60 rounded-xl border border-pink-200/50 text-[#FF7B9C] text-xl">
                    <i class="fa-solid fa-bolt-lightning"></i>
                </div>
                <div>
                    <h1 class="text-xl font-black text-slate-800 tracking-wide flex items-center gap-2">
                        <span>🎭 反應身分組設定核心面板</span>
                    </h1>
                    <p class="text-xs text-slate-600 mt-1">正在設定管理伺服器：<span class="font-bold text-[#FF7B9C]"><%= guildName %></span></p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <a href="/manage/<%= guildId %>" class="px-4 py-2 rounded-xl bg-slate-600/10 hover:bg-slate-600/20 text-slate-700 border border-slate-300/50 font-bold transition flex items-center gap-1.5 text-xs no-underline">
                    <i class="fa-solid fa-arrow-left"></i> 返回群組首頁
                </a>
            </div>
        </div>

        <div id="listView" class="space-y-6">
            <div class="flex justify-between items-center">
                <h2 class="text-sm font-bold text-slate-700 flex items-center gap-2 m-0">
                    <i class="fa-solid fa-folder-open text-[#FF7B9C]"></i> 目前已綁定的訊息清單喵
                </h2>
                <button onclick="createNewConfig()" class="px-4 py-2 rounded-xl bg-gradient-to-r from-[#FF7B9C] to-[#A855F7] hover:opacity-90 text-white font-bold shadow-md transition flex items-center gap-1.5 text-xs">
                    <i class="fa-solid fa-plus"></i> 新增綁定訊息 🐾
                </button>
            </div>

            <div id="msgListContainer" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                </div>
        </div>

        <div id="editView" class="hidden glass-card rounded-2xl p-6 md:p-8">
            <div class="flex items-center justify-between border-b border-pink-200/50 pb-4 mb-6">
                <h2 id="formTitle" class="text-base font-black text-slate-800 flex items-center gap-2 m-0">
                    <i class="fa-solid fa-pen-to-square text-[#FF7B9C]"></i> 編輯反應身分組映射喵
                </h2>
                <button onclick="backToList()" class="text-slate-500 hover:text-slate-800 transition bg-transparent border-0">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>

            <form id="roleForm" onsubmit="return false;" class="space-y-6">
                <input type="hidden" id="currentConfigId" value="">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-2">
                            <i class="fa-solid fa-hashtag text-pink-400"></i> 目標發送頻道 (Target Channel)
                        </label>
                        <select id="channelSelect" class="w-full px-4 py-3 rounded-xl glass-input outline-none text-xs font-bold text-slate-700">
                            <option value="">-- 請選擇一個文字頻道喵 --</option>
                            <% channels.forEach(ch => { %>
                                <option value="<%= ch.id %>"># <%= ch.name %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-2">
                            <i class="fa-solid fa-key text-pink-400"></i> Discord 訊息 ID (Message ID)
                        </label>
                        <input type="text" id="messageIdInput" placeholder="請貼上該頻道中已發布的訊息 ID 喵" class="w-full px-4 py-3 rounded-xl glass-input outline-none text-xs font-mono">
                    </div>
                </div>

                <div class="border-t border-pink-200/30 pt-6">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-xs font-black text-slate-700 flex items-center gap-2 uppercase tracking-wider m-0">
                            <i class="fa-solid fa-icons text-orange-400"></i> 表情反應與對應身份組配對清單
                        </h3>
                        <button type="button" onclick="addNewPairRow()" class="px-2.5 py-1.5 rounded-lg bg-pink-100 hover:bg-pink-200 text-[#FF7B9C] text-xs font-bold transition flex items-center gap-1 border-0">
                            <i class="fa-solid fa-plus-circle"></i> 追加配對 🐾
                        </button>
                    </div>

                    <div id="pairsContainer" class="space-y-3">
                        </div>
                </div>

                <div class="flex flex-col sm:flex-row justify-end gap-3 border-t border-pink-200/30 pt-6">
                    <button type="button" onclick="backToList()" class="px-5 py-2.5 rounded-xl bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold transition text-xs border-0">
                        取消返回
                    </button>
                    <button type="button" id="saveBtn" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#FF7B9C] to-[#A855F7] hover:opacity-95 text-white font-black shadow-md transition text-xs border-0">
                        <i class="fa-solid fa-cloud-arrow-up"></i> 儲存並同步至 Discord 終端 🐾
                    </button>
                </div>
            </form>
        </div>

        <div id="emojiPickerModal" class="fixed inset-0 bg-black/40 z-50 flex items-center justify-center hidden" onclick="closeEmojiPicker()">
            <div class="bg-white rounded-2xl shadow-2xl p-2 relative max-w-full" onclick="event.stopPropagation()">
                <div id="martContainer"></div>
            </div>
        </div>
    </div>

    <script>
        const messageConfigs = <%- JSON.stringify(configs || {}) %>;
        const availableRoles = <%- JSON.stringify(roles || []) %>;
        const channelMap = {};
        <% channels.forEach(c => { %> channelMap["<%= c.id %>"] = "<%= c.name %>"; <% }) %>

        let activeTargetInputId = null;

        function initAllEmojis() {
            const pickerOptions = { 
                onEmojiSelect: (emoji) => {
                    if (activeTargetInputId) {
                        const target = document.getElementById(activeTargetInputId);
                        if (target) {
                            target.value = emoji.native;
                            target.dispatchEvent(new Event('input'));
                        }
                    }
                    closeEmojiPicker();
                },
                locale: 'zh',
                skinTonePosition: 'search'
            };
            const picker = new EmojiMart.Picker(pickerOptions);
            document.getElementById('martContainer').appendChild(picker);
        }

        function openEmojiPicker(inputId) {
            activeTargetInputId = inputId;
            document.getElementById('emojiPickerModal').classList.remove('hidden');
        }

        function closeEmojiPicker() {
            document.getElementById('emojiPickerModal').classList.add('hidden');
            activeTargetInputId = null;
        }

        function renderMsgList() {
            const container = document.getElementById('msgListContainer');
            container.innerHTML = '';
            
            const messageIds = Object.keys(messageConfigs);
            if (messageIds.length === 0) {
                container.innerHTML = `
                    <div class="col-span-full glass-card rounded-2xl p-12 text-center text-slate-500">
                        <i class="fa-solid fa-face-dashed text-3xl mb-3 text-pink-300"></i>
                        <p class="font-bold text-xs">目前此伺服器還沒有建立任何反應身份組配置喵～</p>
                        <p class="text-[11px] text-slate-400 mt-1">點擊右上角「新增綁定訊息」開始部署第一條規則吧！</p>
                    </div>
                `;
                return;
            }

            messageIds.forEach(msgId => {
                const conf = messageConfigs[msgId];
                const channelName = channelMap[conf.channelId] || '未知頻道 (已刪除)';
                
                let badgesHtml = '';
                conf.pairs.forEach(p => {
                    const rObj = availableRoles.find(r => r.id === p.roleId);
                    const rName = rObj ? rObj.name : '未知身分組';
                    badgesHtml += `
                        <div class="flex items-center gap-1.5 bg-white/70 px-2.5 py-1 rounded-lg text-[11px] font-bold text-slate-700 border border-pink-200/40">
                            <span>${p.emoji}</span>
                            <span class="max-w-[120px] truncate">@ ${rName}</span>
                        </div>
                    `;
                });

                const card = document.createElement('div');
                card.className = "glass-card rounded-2xl p-5 flex flex-col justify-between hover:shadow-lg transition duration-300";
                card.innerHTML = `
                    <div>
                        <div class="flex justify-between items-start mb-3">
                            <span class="px-2.5 py-1 rounded-md bg-pink-100 text-[#FF7B9C] font-bold text-xs">
                                <i class="fa-solid fa-hashtag"></i> ${channelName}
                            </span>
                            <span class="text-[11px] font-mono text-slate-400 bg-slate-100 px-2 py-0.5 rounded">ID: ${msgId}</span>
                        </div>
                        <div class="flex flex-wrap gap-2 my-4">
                            ${badgesHtml}
                        </div>
                    </div>
                    <div class="flex justify-end gap-2 border-t border-pink-200/20 pt-4 mt-2">
                        <button onclick="editConfig('${msgId}')" class="px-3 py-1.5 text-xs rounded-lg bg-slate-700 text-white hover:bg-slate-800 font-bold transition flex items-center gap-1 border-0">
                            <i class="fa-solid fa-wrench"></i> 編輯
                        </button>
                        <button onclick="deleteConfig('${msgId}')" class="px-3 py-1.5 text-xs rounded-lg bg-red-50 text-red-600 hover:bg-red-100 font-bold transition flex items-center gap-1 border-0">
                            <i class="fa-solid fa-trash-can"></i> 刪除
                        </button>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function createNewConfig() {
            document.getElementById('currentConfigId').value = "new_msg_" + Date.now();
            document.getElementById('channelSelect').value = '';
            document.getElementById('messageIdInput').value = '';
            
            const pContainer = document.getElementById('pairsContainer');
            pContainer.innerHTML = '';
            addNewPairRow(); 

            switchView(true);
        }

        function editConfig(msgId) {
            const conf = messageConfigs[msgId];
            if (!conf) return;

            document.getElementById('currentConfigId').value = msgId;
            document.getElementById('channelSelect').value = conf.channelId;
            document.getElementById('messageIdInput').value = msgId;

            const pContainer = document.getElementById('pairsContainer');
            pContainer.innerHTML = '';
            
            conf.pairs.forEach(pair => {
                addNewPairRow(pair.emoji, pair.roleId);
            });

            if (conf.pairs.length === 0) addNewPairRow();
            switchView(true);
        }

        function addNewPairRow(savedEmoji = '', savedRoleId = '') {
            const container = document.getElementById('pairsContainer');
            const rowId = 'pair_' + Date.now() + '_' + Math.floor(Math.random() * 1000);
            
            let selectOptions = `<option value="">-- 請選擇身分組喵 --</option>`;
            availableRoles.forEach(role => {
                const selected = role.id === savedRoleId ? 'selected' : '';
                selectOptions += `<option value="${role.id}" ${selected}>@ ${role.name}</option>`;
            });

            const row = document.createElement('div');
            row.id = rowId;
            row.className = "flex items-center gap-3 bg-white/40 p-2 rounded-xl border border-pink-200/30 shadow-sm";
            row.innerHTML = `
                <div class="flex items-center gap-1.5">
                    <input type="text" id="emoji_${rowId}" value="${savedEmoji}" placeholder="🐱" readonly 
                        class="w-12 py-2 text-center rounded-lg glass-input outline-none font-bold text-sm select-none">
                    <button type="button" onclick="openEmojiPicker('emoji_${rowId}')" class="px-2.5 py-2.5 rounded-lg bg-pink-100 hover:bg-pink-200 text-[#FF7B9C] transition text-sm border-0">
                        <i class="fa-regular fa-face-smile"></i>
                    </button>
                </div>
                <div class="flex-1">
                    <select id="role_${rowId}" class="w-full px-3 py-2 rounded-lg glass-input text-xs outline-none font-bold text-slate-700">
                        ${selectOptions}
                    </select>
                </div>
                <button type="button" onclick="removePairRow('${rowId}')" class="text-slate-400 hover:text-red-500 p-2 transition bg-transparent border-0">
                    <i class="fa-solid fa-trash-can"></i>
                </button>
            `;
            container.appendChild(row);
        }

        function removePairRow(rowId) {
            const row = document.getElementById(rowId);
            if (row) row.remove();
        }

        // 雙向切換檢視控制
        function switchView(showEdit) {
            if (showEdit) {
                document.getElementById('listView').classList.add('hidden');
                document.getElementById('editView').classList.remove('hidden');
            } else {
                document.getElementById('listView').classList.remove('hidden');
                document.getElementById('editView').classList.add('hidden');
            }
        }

        function backToList() {
            switchView(false);
            renderMsgList();
        }

        async function deleteConfig(messageId) {
            if (!confirm('主人，妳確定要徹底移除訊息 ' + messageId + ' 下的所有反應身分組設定嗎喵？')) return;

            const guildId = document.getElementById('guildId').value;
            try {
                const res = await fetch('/api/delete-reaction-role', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ guildId, messageId })
                });
                const result = await res.json();
                if (result.status === 'success') {
                    delete messageConfigs[messageId];
                    alert('✨ 喵！反應身份組映射已乾淨抹除囉！');
                    renderMsgList();
                } else {
                    alert('❌ 刪除失敗：' + result.message);
                }
            } catch (err) { alert('💥 無法連線至伺服器：' + err.message); }
        }

        document.getElementById('saveBtn').addEventListener('click', async () => {
            const currentId = document.getElementById('currentConfigId').value;
            const channelId = document.getElementById('channelSelect').value;
            const messageId = document.getElementById('messageIdInput').value.trim();

            if (!channelId) return alert('請選擇要發布或綁定的文字頻道欄位喵！');
            if (!messageId) return alert('訊息 ID 是必填項目，請務必填寫喵！');

            const pairs = [];
            const rowDivs = document.getElementById('pairsContainer').children;
            
            for (let div of rowDivs) {
                const rowId = div.id;
                const emojiVal = document.getElementById(`emoji_${rowId}`).value.trim();
                const roleVal = document.getElementById(`role_${rowId}`).value;
                
                if (emojiVal && roleVal) {
                    pairs.push({ emoji: emojiVal, roleId: roleVal });
                }
            }

            if (pairs.length === 0) return alert('請至少正確配置一組有效的【表情 ⇄ 身份組】對應項目喵！');
            
            const payload = {
                guildId: document.getElementById('guildId').value,
                channelId: channelId,
                messageId: messageId,
                oldMessageId: currentId.startsWith('new_msg_') ? null : currentId,
                pairs: pairs
            };
            
            try {
                const response = await fetch('/api/save-reaction-roles', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await response.json();
                if (result.status === 'success') {
                    if (!currentId.startsWith('new_msg_') && currentId !== messageId) {
                        delete messageConfigs[currentId];
                    }
                    messageConfigs[messageId] = { channelId, messageId, pairs };
                    alert('✨ 喵！反應身分組配置已完美同步發送至 Discord 終端囉！');
                    backToList();
                } else {
                    alert('❌ 儲存失敗了喵：' + result.message);
                }
            } catch (err) { alert('💥 連線伺服器失敗：' + err.message); }
        });

        window.addEventListener('DOMContentLoaded', () => {
            initAllEmojis();
            renderMsgList();
        });
    </script>
</body>
</html>